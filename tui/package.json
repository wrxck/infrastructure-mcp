    "meow": "^13.0.0",
    "react": "^18.3.0",
    "string-width": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^18.3.0",
    "ink-testing-library": "^4.0.0",
